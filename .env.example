APP_NAME=SAQUE
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

# Fuso padrão de apresentação. Datas são SEMPRE persistidas em UTC (CLAUDE.md §6).
APP_DISPLAY_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

# Custo mínimo exigido pelo CLAUDE.md §10.
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- PostgreSQL (docker-compose.yml) -----------------------------------------
DB_CONNECTION=pgsql
# Portas altas: 5432/5433 são usadas por serviços PostgreSQL nativos do Windows
# (postgresql-x64-17 e -18) e 6379 por outro projeto Docker nesta máquina.
DB_HOST=127.0.0.1
DB_PORT=55432
DB_DATABASE=saque
DB_USERNAME=saque
DB_PASSWORD=saque

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookie de sessão httpOnly (ADR 0005). Em produção: Secure + SameSite=Lax.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

# phpredis (extensão C) não está instalada nesta máquina; predis é cliente em PHP puro.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=56379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responda@saque.app"
MAIL_FROM_NAME="${APP_NAME}"

# --- Frontend / CORS / Sanctum (ADR 0005) ------------------------------------
# Allowlist explícita. NUNCA "*" com credenciais (CLAUDE.md §11).
FRONTEND_URL=http://localhost:8080
SANCTUM_STATEFUL_DOMAINS=localhost:8080,127.0.0.1:8080,localhost:3000,127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# --- LGPD: proteção de telefone (CLAUDE.md §12) ------------------------------
# Pepper do HMAC usado em phone_hash. Rotacioná-lo invalida a deduplicação
# existente — só com plano de re-hash. NUNCA versionar o valor real.
PHONE_HASH_PEPPER=

# --- LGPD: proteção de CPF/CNPJ do organizador (ADR 0014) --------------------
DOCUMENT_HASH_PEPPER=

# --- LGPD: proteção de telefone do juiz (ADR 0013 §6) ------------------------
REFEREE_PHONE_HASH_PEPPER=

# --- Pagamentos (ADR 0004) ---------------------------------------------------
# fake = FakePaymentProvider (desenvolvimento e testes, sem rede)
# asaas = integração real, só após consulta à documentação oficial (CLAUDE.md §14)
PAYMENT_PROVIDER=fake

ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# --- Storage de arquivos (CLAUDE.md §19) -------------------------------------
# Binário NUNCA vai para o PostgreSQL. Provedor definido em ADR próprio.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
