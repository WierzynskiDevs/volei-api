# Modelo de variáveis para o ambiente de deploy (Railway).
# Preencher no Railway → Project Settings → Shared Variables (compartilhada entre
# os serviços "api" e "worker"), NUNCA versionar valores reais.
# Ver docs/adr/0012-hospedagem-e-deploy.md e docs/adr/0019-backend-no-railway.md.

APP_NAME=SAQUE
APP_ENV=production
# Gerar com `php artisan key:generate --show` e colar aqui (não commitar).
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://api.SEUDOMINIO.com

APP_DISPLAY_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=warning

# --- PostgreSQL (Neon) --------------------------------------------------------
# Neon fornece uma connection string pronta; DB_URL tem prioridade sobre os
# campos discretos abaixo (config/database.php). sslmode=require é obrigatório
# no Neon.
DB_CONNECTION=pgsql
DB_URL="postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/saque?sslmode=require"
DB_SSLMODE=require

# --- Sessão / cookie httpOnly (ADR 0005) -------------------------------------
# Fila e cache: sem Redis externo no plano gratuito, usa-se as filas nativas
# do Laravel sobre o próprio Postgres (tabelas `jobs` e `cache`) — ver ADR 0012.
SESSION_DRIVER=database
SESSION_LIFETIME=120
# app.SEUDOMINIO.com e api.SEUDOMINIO.com são o MESMO domínio registrável:
# o cookie com Domain=.SEUDOMINIO.com é enviado nos dois, sem SameSite=None.
SESSION_DOMAIN=.SEUDOMINIO.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log

# --- Frontend / CORS / Sanctum (ADR 0005) ------------------------------------
FRONTEND_URL=https://app.SEUDOMINIO.com
SANCTUM_STATEFUL_DOMAINS=app.SEUDOMINIO.com
CORS_ALLOWED_ORIGINS=https://app.SEUDOMINIO.com

# --- LGPD (CLAUDE.md §12) -----------------------------------------------------
# Gerar com `openssl rand -hex 32`. Rotacionar invalida deduplicação existente.
PHONE_HASH_PEPPER=
# Pepper próprio do CPF/CNPJ do organizador (ADR 0014) — não reaproveitar o de telefone.
DOCUMENT_HASH_PEPPER=
# Pepper próprio do telefone do juiz (ADR 0013 §6) — dedup por evento.
REFEREE_PHONE_HASH_PEPPER=

# --- Pagamentos (ADR 0004/0009) -----------------------------------------------
PAYMENT_PROVIDER=fake
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# --- Storage (CLAUDE.md §19) --------------------------------------------------
# Preencher só quando o provedor de storage for escolhido e documentado em ADR
# próprio (§19 exige ADR antes do primeiro upload).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
